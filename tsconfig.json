{
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["ESNext"],
    "types": ["node"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
